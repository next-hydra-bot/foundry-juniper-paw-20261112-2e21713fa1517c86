SHOPIFY_SHOP_ID=123456789
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_STOREFRONT_ORIGIN=https://store.example.com
SHOPIFY_CUSTOMER_SESSION_SECRET=

# Optional for B2C Orders. Use the exact name of this storefront's identity provider in Shopify.
# SHOPIFY_CUSTOMER_IDENTITY_PROVIDER_NAME=Clerk

# Authenticated web/API runtime: private immutable customer identity associations.
# Use the same Shopify app that owns the company identity records.
# Configure the installed Admin app's client credentials for automatic acquisition.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Alternative: a separately managed supplied token, with no client credentials.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
