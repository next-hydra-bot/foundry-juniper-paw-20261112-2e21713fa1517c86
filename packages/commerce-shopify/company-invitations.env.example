# Shopify B2B web runtime only. Load alongside customer-accounts.env.example.
# An installed Admin app with customer reads and company reads/writes.
# Configure SHOPIFY_ADMIN_CLIENT_ID and SHOPIFY_ADMIN_CLIENT_SECRET as described
# in customer-accounts.env.example, or a separately managed SHOPIFY_ADMIN_ACCESS_TOKEN.
# Read exact role IDs from each native Company. Empty bindings disable invitation administration.
SHOPIFY_COMPANY_ROLE_BINDINGS=[]
# Example (replace every native ID with the actual shop IDs):
# SHOPIFY_COMPANY_ROLE_BINDINGS=[{"companyId":"gid://shopify/Company/100","buyerRoleId":"gid://shopify/CompanyContactRole/200","adminRoleIds":["gid://shopify/CompanyContactRole/201"]}]
# Set only the selected Auth Provider's secret for the web-app webhook.
# CLERK_WEBHOOK_SECRET=whsec_...
# WORKOS_WEBHOOK_SECRET=...

# Company registration API only; exact native role IDs, with the initial admin role first.
# SHOPIFY_REGISTRATION_ROLES={"buyerRoleId":"gid://shopify/CompanyContactRole/200","adminRoleIds":["gid://shopify/CompanyContactRole/201"]}
# Web and API must use the same installed Admin app so private records are shared.
# Registration approval also needs the existing API/admin auth, origins and email credentials.

# Optional automatic approval-time purchasing assignment in the API app.
# Also required by the web runtime when Shopify B2B Algolia search is selected;
# that runtime Admin app needs read_markets to check the selected location's native pricing Market membership.
# Exact native IDs from the B2B catalog setup; [] retains manual assignment.
SHOPIFY_COMPANY_PURCHASING_POLICIES=[]
