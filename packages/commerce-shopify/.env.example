SHOPIFY_STORE_DOMAIN=example.myshopify.com
# Private token from the Headless storefront. Enable these Storefront API permissions there:
# unauthenticated_read_product_listings, unauthenticated_read_product_inventory,
# unauthenticated_read_customers. Admin read_inventory is a separate permission.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-10

# Web runtime: the Admin app's client secret used to sign catalog webhooks.
# commerce webhooks provision publishes this from SHOPIFY_ADMIN_CLIENT_SECRET.
SHOPIFY_CATALOG_WEBHOOK_SECRET=

# Authenticated runtime and provisioning CLI: acquire and cache the installed Admin app token.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Alternative to the client credentials above; configure exactly one mode.
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify B2B selects the shared db package. Set DATABASE_URL in API and web.
# See packages/db/.env.example and run pnpm --filter @repo/db migrate.
