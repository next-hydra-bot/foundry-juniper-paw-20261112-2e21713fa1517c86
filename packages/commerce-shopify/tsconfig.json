{
  "extends": "@repo/typescript-config/effect-nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "plugins": [
      {
        "name": "next"
      },
      {
        "name": "@effect/language-service",
        "diagnostics": false,
        "includeSuggestionsInTsc": false
      },
      {
        "name": "@shopify/hydrogen/ts-plugin"
      }
    ],
    "paths": {
      "@repo/commerce-shopify/*": ["./*"],
      "@repo/*": ["../*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "registry", "**/*.template.*"]
}
