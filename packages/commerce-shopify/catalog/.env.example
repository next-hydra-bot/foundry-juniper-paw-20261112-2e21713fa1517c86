# Credentials for the installed Admin app. Token exchange is automatic.
SHOPIFY_STORE_DOMAIN=example.myshopify.com
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=
# Alternative: use a separately managed Admin token and omit the client secret.
# SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CATALOG_LOCATION_ID=gid://shopify/Location/123
# Publication for the same Headless storefront whose private token the web app uses.
# The importer publishes products and collections here. Do not use Online Store's ID.
SHOPIFY_CATALOG_PUBLICATION_ID=gid://shopify/Publication/123
